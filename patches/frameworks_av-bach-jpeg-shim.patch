+                outputBuffers[i].buffer != nullptr &&
+                listener != nullptr &&
+                property_get_bool("persist.bach.jpeg.shim", true)) {
+            ALOGI("BACH: delivering BLOB streamId=%d frame=%" PRId64
+                  " despite HAL STATUS_ERROR (trusting encoded JPEG)",
+                  streamId, inResultExtras.frameNumber);
+            const_cast<camera3_stream_buffer_t&>(outputBuffers[i]).status =
+                    CAMERA3_BUFFER_STATUS_OK;
+        }
+
