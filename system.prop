# bach: ro.zygote was not emitted by the build for this A11 port (core_64_bit did not
# set it), so init expanded `import /system/etc/init/hw/init.${ro.zygote}.rc` to nothing
# → no zygote service → boot hung forever at the LineageOS animation (surfaceflinger ran,
# system_server never forked). TARGET_SYSTEM_PROP forces it into /system/build.prop,
# which init's property_load_boot_defaults() reads before parsing init.rc.
ro.zygote=zygote64_32

# ART Dalvik heap — set here (auto-appended to /system/build.prop) rather than via
# PRODUCT_PROPERTY_OVERRIDES / the dalvik-heap.mk inherit, which land in /vendor/build.prop on
# this tree and get overwritten by the prebuilt A10 vendor.img. Without these ART clamps to
# ~16 MB and heavy apps (Telegram, browsers) OOM at launch. 3 GB device → 192m growth, 512m largeHeap.
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# Graphics / SurfaceFlinger / GLES — system-context tunings the device tree intended but
# lost to the same /vendor-override (PRODUCT_PROPERTY_OVERRIDES -> /vendor/build.prop,
# overwritten by the prebuilt A10 vendor.img; vendor_prop.mk is also orphaned/never inherited).
# ro.opengles.version is the important one: without it PackageManager reports GLES UNDEFINED
# and Play Store can hide GLES-gated apps. SurfaceFlinger reads ro.surface_flinger.*/debug.sf.*
# from the global prop namespace (these are system-owned, so /system/build.prop is the right home).
ro.opengles.version=196610
ro.surface_flinger.protected_contents=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.vsync_event_phase_offset_ns=2000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=6000000
debug.sf.early_phase_offset_ns=500000
debug.sf.early_app_phase_offset_ns=500000
debug.sf.early_gl_phase_offset_ns=3000000
debug.sf.early_gl_app_phase_offset_ns=15000000
debug.sf.latch_unsignaled=0
debug.sf.enable_gl_backpressure=1
ro.config.media_vol_steps=15
ro.config.vc_call_vol_steps=7
sys.use_fifo_ui=1

# Radio — the A10 vendor's /vendor/bin/hw/rild is started WITHOUT a "-l <lib>" argument
# (/vendor/etc/init/rild.legacy.rc) and resolves the RIL library from rild.libpath alone.
# With the prop unset it takes the "assume no-ril case" branch and sleeps forever:
#     RILD: **RILd param count=1**  /  RILD: RIL_Init starting sleep loop
# and no "rilInit completed" / "RIL_register completed" / "dlopen failed" ever follows —
# so RILJ never connects, gsm.version.baseband and gsm.sim.state stay empty and the modem
# looks dead while init.svc.ril-daemon reads "running".
# On LOS 17.1 these lived in /system/build.prop (Q routed PRODUCT_PROPERTY_OVERRIDES to
# ADDITIONAL_BUILD_PROPERTIES); flashing the A11 system dropped them, and vendor_prop.mk
# cannot bring them back (orphaned, and /vendor is a prebuilt image we overwrite wholesale).
# Values verified against a live BAH-L09 on surdu's 17.1; libril-qc-qmi-1.so is present in
# the A10 vendor. Neither prop is persist.*, so a clean flash loses them unconditionally.
rild.libpath=/vendor/lib64/libril-qc-qmi-1.so
rild.libargs=-d /dev/smd0
ril.subscription.types=NV,RUIM
ro.telephony.use_old_mnc_mcc_format=true
ro.telephony.call_ring.multiple=false

# RIL behaviour — read by libril-qc-qmi-1.so during init. Same provenance as the
# rild.libpath block above: live on 17.1, declared in the orphaned vendor_prop.mk,
# emitted nowhere on this build. See docs/LOST-PROPS.md tier A2.
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.rat_on=combine
persist.vendor.radio.sib16_support=1
persist.data.iwlan.enable=true

# Data path — netmgrd carries the data calls on this legacy QCOM target, and cnd
# is expected to run (BOARD_USES_QCNE := true in BoardConfig.mk). Without these the
# modem can attach and read the SIM while data calls still fail, so they belong
# with the rild.libpath fix rather than after it. docs/LOST-PROPS.md tier A1.
ro.vendor.use_data_netmgrd=true
persist.data.netmgrd.qos.enable=true
persist.vendor.data.mode=concurrent
persist.vendor.cne.feature=1
persist.vendor.dpm.feature=0
persist.vendor.sys.cnd.iwlan=1

# Singles from the same lost set (docs/LOST-PROPS.md tier A6).
#   ro.frp.pst           PersistentDataBlockService stays disabled without it; the
#                        partition exists (config -> mmcblk0p41 on this device).
#   ro.gps.agps_provider AGPS.
#   ro.vendor.extension_library  the framework's perf-hint client. The blob is present
#                        (/vendor/lib{,64}/libqti-perfd-client.so); unset means no perfd
#                        integration at all, which on 17.1 it had.
#   wifi.interface       Wi-Fi already works, so this is belt-and-braces.
ro.frp.pst=/dev/block/bootdevice/by-name/config
ro.gps.agps_provider=1
ro.vendor.extension_library=libqti-perfd-client.so
wifi.interface=wlan0

# Display / SDM (docs/LOST-PROPS.md tier A3). Every name here was found by grepping
# the vendor image for it, so each has a real reader on this device:
#   vendor.display.*   -> lib{,64}/hw/hwcomposer.msm8937.so
#   ro.vendor.display.cabl -> bin/mm-pp-dpps, lib{,64}/libsdmextension.so
# disable_skip_validate is a correctness workaround on legacy SDM targets, not a
# tuning: without it the composer skips a validate step it actually needs here.
# The pre-Treble spellings surdu also carried (sdm.debug.disable_skip_validate,
# sdm.debug.disable_rotator_split, sdm.perf_hint_window, ro.qualcomm.cabl) appear in
# no vendor binary on this device and are deliberately not restored.
vendor.display.disable_skip_validate=1
vendor.display.perf_hint_window=50
vendor.display.enable_default_color_mode=1
ro.vendor.display.cabl=2

# USB — NOT a tuning: the legacy android_usb composition chain in the vendor's
# init.qcom.usb.rc is keyed on the literal string "rndis,none".
#     on property:sys.usb.config=rndis
#         setprop sys.usb.config rndis,${persist.vendor.usb.config.extra}
#     on property:sys.usb.config=rndis,none && property:sys.usb.configfs=0
#         ... write functions rndis ... enable 1 ... setprop sys.usb.state rndis
# With the prop unset the middle step yields "rndis," which matches no trigger, so
# the rndis composition is never applied and USB tethering silently does nothing.
# This device is on the legacy path (sys.usb.configfs=0 in the live dump), and the
# "rndis,none,adb" variant breaks the same way. rps_mask is read as ${...} too.
persist.vendor.usb.config.extra=none
vendor.usb.rps_mask=0

# Audio HAL — every name below was found by strings(1) in lib{,64}/hw/audio.primary.msm8937.so,
# the A10 blob this build still runs, so each has a confirmed reader. Unset, the HAL falls
# back to its compiled-in defaults instead of the values it ran with on 17.1.
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.speaker=true
persist.vendor.audio.fluence.voicerec=true
ro.vendor.audio.sdk.fluencetype=fluence
ro.vendor.audio.sdk.ssr=false
vendor.audio_hal.period_size=192
vendor.audio.offload.buffer.size.kb=64
vendor.audio.offload.gapless.enabled=true
vendor.audio.offload.multiple.enabled=false
vendor.audio.playback.mch.downsample=true
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
vendor.voice.path.for.pcm.voip=true
